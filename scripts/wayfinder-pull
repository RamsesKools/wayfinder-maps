#!/usr/bin/env bash
# Mirror a wayfinder map stored as GitHub issues into the .plan/ layout that
# wayfinder-maps reads. Read-only against GitHub; the .plan tree is a cache and
# is safe to delete. Needs `gh` (logged in) and `jq`.
#
#   scripts/wayfinder-pull [--account <gh-user>] [--progress] <owner/repo> <map-issue-number> [out-dir]
#   scripts/wayfinder-pull [--account <gh-user>] [--progress] --refresh <out-dir>
#
# --account (or WAYFINDER_GH_ACCOUNT) pulls as that gh account instead of the
# active one, via GH_TOKEN=$(gh auth token --user <gh-user>).
# --progress also prints "progress <done> <total>" lines; the total can grow
# mid-pull. The viewer uses them for its progress display.
# Each pull records <out-dir>/.source.json (repo, map issue, gh auth kind and
# account). --refresh re-pulls from it, using that account's token even if the
# active gh account has since changed; --account on a refresh changes it.
# Ticket numbers are the GitHub issue numbers, so #22 stays 22 everywhere.
set -euo pipefail

usage() {
  echo "usage: wayfinder-pull [--account <gh-user>] [--progress] <owner/repo> <map-issue-number> [out-dir]" >&2
  echo "       wayfinder-pull [--account <gh-user>] [--progress] --refresh <out-dir>" >&2
  exit 2
}

auth=""
account=${WAYFINDER_GH_ACCOUNT:-}
want_account=$account
refresh=""
progress=""
pos=()
while [ $# -gt 0 ]; do
  case "$1" in
    --refresh) refresh=1 ;;
    --progress) progress=1 ;;
    --account)
      [ $# -ge 2 ] && [ -n "$2" ] || { echo "wayfinder-pull: --account needs a gh user name" >&2; exit 2; }
      want_account=$2; shift ;;
    --account=*) want_account=${1#--account=} ;;
    -*) echo "wayfinder-pull: unknown option $1" >&2; usage ;;
    *) pos+=("$1") ;;
  esac
  shift
done

emit() { [ -z "$progress" ] || echo "progress $1 $2"; }

if [ -n "$refresh" ]; then
  out=${pos[0]:-}
  if [ -z "$out" ] || [ ! -f "$out/.source.json" ]; then
    echo "wayfinder-pull: --refresh needs a pulled map dir containing .source.json" >&2
    exit 2
  fi
  repo=$(jq -r '.repo // ""' "$out/.source.json")
  map=$(jq -r '.map // ""' "$out/.source.json")
  auth=$(jq -r '.auth // ""' "$out/.source.json")
  account=$(jq -r '.account // ""' "$out/.source.json")
  if [ -n "$want_account" ]; then
    auth=gh
    account=$want_account
  fi
else
  repo=${pos[0]:-}
  map=${pos[1]:-}
  out=${pos[2]:-}
  if [ -n "$want_account" ]; then
    auth=gh
    account=$want_account
  fi
fi
if [ -z "$repo" ] || [ -z "$map" ]; then
  usage
fi

if [ "$auth" = "gh" ] && [ -n "$account" ]; then
  GH_TOKEN=$(gh auth token --user "$account" 2>/dev/null) && [ -n "$GH_TOKEN" ] \
    || { echo "wayfinder-pull: gh account '$account' is not logged in (run: gh auth login)" >&2; exit 2; }
  export GH_TOKEN
fi

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E -e 's/[^a-z0-9]+/-/g' -e 's/^-//' -e 's/-$//' \
    | cut -c1-50 | sed -e 's/-$//'
}

if [ -z "$auth" ]; then
  if [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]; then
    auth=env
  else
    auth=gh
    account=$(gh api user --jq .login 2>/dev/null || true)
  fi
fi

emit 0 1
mapjson=$(gh api "repos/$repo/issues/$map")
maptitle=$(jq -r .title <<<"$mapjson")
mapbody=$(jq -r '.body // ""' <<<"$mapjson")

if [ -z "$out" ]; then
  out=".plan/$(slugify "$maptitle")"
fi

emit 1 1
subs=$(gh api --paginate "repos/$repo/issues/$map/sub_issues")
count=$(jq 'length' <<<"$subs")
if [ "$count" = "0" ]; then
  echo "wayfinder-pull: issue #$map has no sub-issues" >&2
  exit 2
fi

total=$((count + 1))
emit 1 "$total"
rm -rf "$out"
mkdir -p "$out/tickets"

decisions=""
implemented=""
outofscope=""
declare -a rewrites=()

for i in $(seq 0 $((count - 1))); do
  t=$(jq -c ".[$i]" <<<"$subs")
  num=$(jq -r .number <<<"$t")
  title=$(jq -r .title <<<"$t")
  state=$(jq -r .state <<<"$t")
  reason=$(jq -r '.state_reason // ""' <<<"$t")
  updated=$(jq -r .updated_at <<<"$t")
  assignee=$(jq -r '.assignees[0].login // ""' <<<"$t")
  nblocked=$(jq -r '.issue_dependencies_summary.total_blocked_by // 0' <<<"$t")
  type=$(jq -r '[.labels[].name | select(startswith("wayfinder:") and . != "wayfinder:afk")][0] // "wayfinder:grilling"' <<<"$t" \
    | sed 's/^wayfinder://')
  case "$type" in research|prototype|grilling|task|implement) ;; *) type=grilling ;; esac
  afk=$(jq -r '[.labels[].name] | index("wayfinder:afk") != null' <<<"$t")

  pr=""
  if [ "$type" = "implement" ]; then
    prs=$(gh api graphql -f query='
      query($owner: String!, $name: String!, $number: Int!) {
        repository(owner: $owner, name: $name) {
          issue(number: $number) {
            closedByPullRequestsReferences(first: 20, includeClosedPrs: true) {
              nodes { url merged }
            }
          }
        }
      }' -f owner="${repo%%/*}" -f name="${repo#*/}" -F number="$num" \
      | jq -c '.data.repository.issue.closedByPullRequestsReferences.nodes')
    pr=$(jq -r '(map(select(.merged))[0] // .[0]).url // ""' <<<"$prs")
    if [ "$(jq 'length' <<<"$prs")" -gt 1 ]; then
      echo "wayfinder-pull: #$num links more than one PR; using $pr" >&2
    fi
  fi

  blocked_by="[]"
  if [ "$nblocked" != "0" ]; then
    blocked_by=$(gh api "repos/$repo/issues/$num/dependencies/blocked_by" \
      | jq -c '[.[].number]')
  fi

  slug=$(slugify "$title")
  file="$out/tickets/$num-$slug.md"
  rewrites+=("s#https://github\\.com/$repo/issues/$num([^0-9]|\$)#./tickets/$num-$slug.md\\1#g")

  {
    echo '---'
    echo "type: $type"
    echo "blocked_by: $blocked_by"
    [ -z "$pr" ] || echo "pr: $pr"
    [ "$afk" != "true" ] || echo "afk: true"
    if [ "$state" = "open" ] && [ -n "$assignee" ]; then
      echo "claimed_by: $assignee"
      echo "claimed_at: $updated"
    fi
    echo '---'
    echo
    echo "# $title"
    echo
    jq -r '.body // ""' <<<"$t"
  } > "$file"

  if [ "$state" = "closed" ]; then
    answer=$(gh api --paginate "repos/$repo/issues/$num/comments" \
      | jq -r '[.[].body] | join("\n\n---\n\n")' \
      | sed -E 's/^(#{1,5}) /#\1 /')
    if [ -z "$answer" ]; then
      if [ "$type" = "implement" ] && [ "$reason" != "not_planned" ] && [ -n "$pr" ]; then
        answer="Shipped in $pr."
      else
        answer="_Closed on GitHub with no answer comment._"
      fi
    fi
    if [ "$reason" = "not_planned" ]; then
      printf '\n## Ruled out\n\n%s\n' "$answer" >> "$file"
      outofscope="$outofscope- [$title](./tickets/$num-$slug.md)
"
    else
      printf '\n## Answer\n\n%s\n' "$answer" >> "$file"
      if [ "$type" = "implement" ]; then
        implemented="$implemented- [$title](./tickets/$num-$slug.md)
"
      else
        decisions="$decisions- [$title](./tickets/$num-$slug.md)
"
      fi
    fi
  fi

  echo "  #$num  $type  $state${assignee:+  @$assignee}"
  emit $((i + 2)) "$total"
done

# The map issue body is already a wayfinder map; its ticket references are
# issue URLs, so point them at the mirrored files instead. A section the body
# does not carry is generated from the ticket states.
sedargs=()
for r in "${rewrites[@]}"; do sedargs+=(-e "$r"); done
mapbody=$(printf '%s\n' "$mapbody" | sed -E "${sedargs[@]}")

{
  echo "# $maptitle"
  echo
  printf '%s\n' "$mapbody"
  if [ -n "$decisions" ] && ! grep -q '^## Decisions so far' <<<"$mapbody"; then
    echo
    echo '## Decisions so far'
    echo
    printf '%s' "$decisions"
  fi
  if [ -n "$implemented" ] && ! grep -q '^## Implemented so far' <<<"$mapbody"; then
    echo
    echo '## Implemented so far'
    echo
    printf '%s' "$implemented"
  fi
  if [ -n "$outofscope" ] && ! grep -q '^## Out of scope' <<<"$mapbody"; then
    echo
    echo '## Out of scope'
    echo
    printf '%s' "$outofscope"
  fi
} > "$out/map.md"

jq -n --arg repo "$repo" --argjson map "$map" --arg auth "$auth" --arg account "$account" \
  '{repo: $repo, map: $map, auth: $auth, account: $account}' > "$out/.source.json"

echo "wayfinder-pull: $repo#$map -> $out ($count tickets)"
